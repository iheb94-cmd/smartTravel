<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/offersFragment">

    <fragment
        android:id="@+id/offersFragment"
        android:name="com.isetr.smarttravel.ui.offers.OffersFragment"
        android:label="Offres">
        <action
            android:id="@+id/action_offers_to_details"
            app:destination="@id/offerDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/offerDetailsFragment"
        android:name="com.isetr.smarttravel.ui.offers.OffreDetailsFragment"
        android:label="Détails de l'offre">
        <argument
            android:name="offreId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.isetr.smarttravel.ui.auth.RegisterFragment"
        android:label="Inscription">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.isetr.smarttravel.ui.auth.LoginFragment"
        android:label="Connexion">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <!-- التعديل هنا: بعد الـ Login يرجع للـ offersFragment ويمسح الـ loginFragment من الـ back stack -->
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/offersFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_forgot"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>



    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.isetr.smarttravel.ui.auth.ForgotPasswordFragment"
        android:label="Mot de passe oublié">
        <action
            android:id="@+id/action_forgot_to_reset"
            app:destination="@id/resetPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/resetPasswordFragment"
        android:name="com.isetr.smarttravel.ui.auth.ResetPasswordFragment"
        android:label="Nouveau mot de passe">
        <action
            android:id="@+id/action_reset_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>